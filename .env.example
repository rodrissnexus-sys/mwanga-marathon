# Copy to .env.local and fill in (Supabase → Project Settings). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Connect → Session pooler (IPv4). Only needed for migrations, type generation and the data import.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000
